{"id": "sk-date-001", "lang": "sk", "category": "date", "prompt": "Prepíš tento údaj do jednej vety pre zákazníka: delivery_date = 2026-03-05", "checks": [{"type": "regex", "value": "\\b0?5\\. ?0?3\\. ?2026\\b|\\b5\\. marca 2026\\b"}, {"type": "not_regex", "value": "2026-03-05|\\b0?3/0?5/2026\\b|March 5"}], "reference": "Vaša objednávka bude doručená 5. 3. 2026.", "counterexample": "Vaša objednávka bude doručená 2026-03-05."}
{"id": "sk-date_long-002", "lang": "sk", "category": "date_long", "prompt": "Napíš jednou vetou, kedy sa začína konferencia: start = 2026-10-14. Mesiac vypíš slovom.", "checks": [{"type": "regex", "value": "\\b14\\. októbra 2026\\b"}, {"type": "not_regex", "value": "október 14|14 októbra"}], "reference": "Konferencia sa začína 14. októbra 2026.", "counterexample": "Konferencia sa začína október 14, 2026."}
{"id": "sk-money-003", "lang": "sk", "category": "money", "prompt": "Napíš zákazníkovi jednou vetou, koľko zaplatí: total = 1234.5 EUR", "checks": [{"type": "regex", "value": "\\b1 ?234,50? ?(€|eur\\b|EUR\\b)"}, {"type": "not_regex", "value": "1,234\\.5|1234\\.5|€ ?1"}], "reference": "Celkovo zaplatíte 1 234,50 €.", "counterexample": "Celkovo zaplatíte €1,234.50."}
{"id": "sk-money_large-004", "lang": "sk", "category": "money_large", "prompt": "Rozpočet projektu je 2500000 EUR. Napíš to jednou vetou, sumu číslicami.", "checks": [{"type": "regex", "value": "2 500 000 ?(€|eur|EUR)|2,5 mil", "flags": "i"}, {"type": "not_regex", "value": "2,500,000|2\\.500\\.000"}], "reference": "Rozpočet projektu je 2 500 000 €.", "counterexample": "Rozpočet projektu je 2,500,000 EUR."}
{"id": "sk-percent-005", "lang": "sk", "category": "percent", "prompt": "Z anglického reportu: inflation 3.7%. Napíš to jednou slovenskou vetou číslicami so znakom percenta.", "checks": [{"type": "regex", "value": "\\b3,7 %"}, {"type": "not_regex", "value": "3\\.7"}], "reference": "Inflácia dosiahla 3,7 %.", "counterexample": "Inflácia dosiahla 3.7%."}
{"id": "sk-decimal-006", "lang": "sk", "category": "decimal", "prompt": "Senzor nameral: avg_temp = 21.5 °C. Napíš to jednou vetou.", "checks": [{"type": "regex", "value": "\\b21,5 ?°C"}, {"type": "not_regex", "value": "21\\.5"}], "reference": "Priemerná teplota bola 21,5 °C.", "counterexample": "Priemerná teplota bola 21.5 °C."}
{"id": "sk-quotes-007", "lang": "sk", "category": "quotes", "prompt": "Napíš jednu vetu s priamou rečou, v ktorej Jana povie: Zajtra prídem neskôr. Použi úvodzovky.", "checks": [{"type": "regex", "value": "„[^„“”\\\"]+“"}, {"type": "not_regex", "value": "\\\"[^\\\"]+\\\""}], "reference": "Jana povedala: „Zajtra prídem neskôr.“", "counterexample": "Jana povedala: \"Zajtra prídem neskôr.\""}
{"id": "sk-register-008", "lang": "sk", "category": "register", "prompt": "Napíš krátku správu (2 – 3 vety) zákazníkovi, ktorého osobne nepoznáš, že jeho objednávka mešká o dva dni.", "checks": [{"type": "regex", "value": "\\b(Vám|Vás|Vaša|Vašu|Vaše|Vašej|Vy)\\b", "flags": "i"}, {"type": "not_regex", "value": "\\b(ti|ťa|tebe|tvoja|tvoju|tvoj|tvoje)\\b", "flags": "i"}], "reference": "Dobrý deň, ospravedlňujeme sa, Vaša objednávka mešká o dva dni. Ďakujeme Vám za trpezlivosť.", "counterexample": "Ahoj, tvoja objednávka mešká o dva dni. Ďakujem ti za trpezlivosť."}
