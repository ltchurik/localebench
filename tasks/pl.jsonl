{"id": "pl-date-001", "lang": "pl", "category": "date", "prompt": "Przepisz tę informację w jednym zdaniu dla klienta: delivery_date = 2026-03-05", "checks": [{"type": "regex", "value": "\\b0?5\\.0?3\\.2026\\b|\\b5 marca 2026\\b"}, {"type": "not_regex", "value": "2026-03-05|\\b0?3/0?5/2026\\b|March 5"}], "reference": "Państwa zamówienie zostanie dostarczone 5 marca 2026 r.", "counterexample": "Państwa zamówienie zostanie dostarczone 2026-03-05."}
{"id": "pl-date_long-002", "lang": "pl", "category": "date_long", "prompt": "Napisz w jednym zdaniu, kiedy zaczyna się konferencja: start = 2026-10-14. Miesiąc zapisz słownie.", "checks": [{"type": "regex", "value": "\\b14 października 2026\\b"}, {"type": "not_regex", "value": "październik 14"}], "reference": "Konferencja zaczyna się 14 października 2026 r.", "counterexample": "Konferencja zaczyna się październik 14, 2026."}
{"id": "pl-money-003", "lang": "pl", "category": "money", "prompt": "Napisz klientowi w jednym zdaniu, ile zapłaci: total = 1234.5 PLN", "checks": [{"type": "regex", "value": "\\b1 ?234,50? ?(zł|PLN)"}, {"type": "not_regex", "value": "1,234\\.5|1234\\.5"}], "reference": "Łącznie zapłaci Pan 1 234,50 zł.", "counterexample": "Łącznie zapłaci Pan 1,234.50 PLN."}
{"id": "pl-money_large-004", "lang": "pl", "category": "money_large", "prompt": "Budżet projektu wynosi 2500000 PLN. Napisz to w jednym zdaniu, kwotę cyframi.", "checks": [{"type": "regex", "value": "2 500 000 ?(zł|PLN)|2,5 mln", "flags": "i"}, {"type": "not_regex", "value": "2,500,000|2\\.500\\.000"}], "reference": "Budżet projektu wynosi 2 500 000 zł.", "counterexample": "Budżet projektu wynosi 2,500,000 PLN."}
{"id": "pl-percent-005", "lang": "pl", "category": "percent", "prompt": "Z angielskiego raportu: inflation 3.7%. Napisz to w jednym polskim zdaniu cyframi ze znakiem procentu.", "checks": [{"type": "regex", "value": "\\b3,7 ?%"}, {"type": "not_regex", "value": "3\\.7"}], "reference": "Inflacja wyniosła 3,7%.", "counterexample": "Inflacja wyniosła 3.7%."}
{"id": "pl-decimal-006", "lang": "pl", "category": "decimal", "prompt": "Czujnik zmierzył: avg_temp = 21.5 °C. Napisz to w jednym zdaniu.", "checks": [{"type": "regex", "value": "\\b21,5 ?°C"}, {"type": "not_regex", "value": "21\\.5"}], "reference": "Średnia temperatura wyniosła 21,5 °C.", "counterexample": "Średnia temperatura wyniosła 21.5 °C."}
{"id": "pl-quotes-007", "lang": "pl", "category": "quotes", "prompt": "Napisz jedno zdanie z mową niezależną, w którym Jana mówi: Jutro przyjdę później. Użyj cudzysłowu.", "checks": [{"type": "regex", "value": "„[^„“”\\\"]+”"}, {"type": "not_regex", "value": "\\\"[^\\\"]+\\\""}], "reference": "Jana powiedziała: „Jutro przyjdę później”.", "counterexample": "Jana powiedziała: \"Jutro przyjdę później\"."}
{"id": "pl-register-008", "lang": "pl", "category": "register", "prompt": "Napisz krótką wiadomość (2–3 zdania) do klienta, którego nie znasz osobiście, że jego zamówienie spóźni się o dwa dni.", "checks": [{"type": "regex", "value": "\\b(Pan|Pani|Pana|Panu|Państwo|Państwa|Państwu)\\b", "flags": "i"}, {"type": "not_regex", "value": "\\b(ty|ciebie|cię|tobie|twoje|twoja|twój|twoim)\\b", "flags": "i"}], "reference": "Dzień dobry, przepraszamy, Pana zamówienie spóźni się o dwa dni. Dziękujemy Panu za cierpliwość.", "counterexample": "Cześć, twoje zamówienie spóźni się o dwa dni. Dzięki za cierpliwość!"}
