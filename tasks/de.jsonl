{"id": "de-date-001", "lang": "de", "category": "date", "prompt": "Formuliere diese Angabe als einen Satz für einen Kunden: delivery_date = 2026-03-05", "checks": [{"type": "regex", "value": "\\b0?5\\.0?3\\.2026\\b|\\b0?5\\. März 2026\\b"}, {"type": "not_regex", "value": "2026-03-05|\\b0?3/0?5/2026\\b|March 5"}], "reference": "Ihre Bestellung wird am 05.03.2026 geliefert.", "counterexample": "Ihre Bestellung wird am 2026-03-05 geliefert."}
{"id": "de-date_long-002", "lang": "de", "category": "date_long", "prompt": "Schreibe in einem Satz, wann die Konferenz beginnt: start = 2026-10-14. Schreibe den Monat aus.", "checks": [{"type": "regex", "value": "\\b14\\. Oktober 2026\\b"}, {"type": "not_regex", "value": "Oktober 14"}], "reference": "Die Konferenz beginnt am 14. Oktober 2026.", "counterexample": "Die Konferenz beginnt am Oktober 14, 2026."}
{"id": "de-money-003", "lang": "de", "category": "money", "prompt": "Schreibe dem Kunden in einem Satz, wie viel er bezahlt: total = 1234.5 EUR", "checks": [{"type": "regex", "value": "\\b1[. ]?234,50? ?(€|EUR\\b|Euro\\b)"}, {"type": "not_regex", "value": "1,234\\.5|1234\\.5|€ ?1"}], "reference": "Sie zahlen insgesamt 1.234,50 €.", "counterexample": "Sie zahlen insgesamt €1,234.50."}
{"id": "de-money_large-004", "lang": "de", "category": "money_large", "prompt": "Das Projektbudget beträgt 2500000 EUR. Schreibe das in einem Satz, den Betrag in Ziffern.", "checks": [{"type": "regex", "value": "2[. ]500[. ]000 ?(€|EUR|Euro)|2,5 Mio", "flags": "i"}, {"type": "not_regex", "value": "2,500,000"}], "reference": "Das Projektbudget beträgt 2.500.000 €.", "counterexample": "Das Projektbudget beträgt 2,500,000 EUR."}
{"id": "de-percent-005", "lang": "de", "category": "percent", "prompt": "Aus einem englischen Bericht: inflation 3.7%. Schreibe das in einem deutschen Satz mit Ziffern und Prozentzeichen.", "checks": [{"type": "regex", "value": "\\b3,7 ?%"}, {"type": "not_regex", "value": "3\\.7"}], "reference": "Die Inflation lag bei 3,7 %.", "counterexample": "Die Inflation lag bei 3.7%."}
{"id": "de-decimal-006", "lang": "de", "category": "decimal", "prompt": "Der Sensor hat gemessen: avg_temp = 21.5 °C. Schreibe das in einem Satz.", "checks": [{"type": "regex", "value": "\\b21,5 ?°C"}, {"type": "not_regex", "value": "21\\.5"}], "reference": "Die Durchschnittstemperatur betrug 21,5 °C.", "counterexample": "Die Durchschnittstemperatur betrug 21.5 °C."}
{"id": "de-quotes-007", "lang": "de", "category": "quotes", "prompt": "Schreibe einen Satz mit wörtlicher Rede, in dem Jana sagt: Morgen komme ich später. Verwende Anführungszeichen.", "checks": [{"type": "regex", "value": "„[^„“”\\\"]+“|»[^»«]+«"}, {"type": "not_regex", "value": "\\\"[^\\\"]+\\\""}], "reference": "Jana sagte: „Morgen komme ich später.“", "counterexample": "Jana sagte: \"Morgen komme ich später.\""}
{"id": "de-register-008", "lang": "de", "category": "register", "prompt": "Schreibe eine kurze Nachricht (2–3 Sätze) an einen Kunden, den du nicht persönlich kennst, dass seine Bestellung zwei Tage später ankommt.", "checks": [{"type": "regex", "value": "\\b(Ihnen|Ihre|Ihr|Ihrer|Sie)\\b"}, {"type": "not_regex", "value": "\\b(du|dich|dir|dein|deine|deiner)\\b", "flags": "i"}], "reference": "Guten Tag, leider kommt Ihre Bestellung zwei Tage später an. Wir danken Ihnen für Ihre Geduld.", "counterexample": "Hallo, deine Bestellung kommt leider zwei Tage später. Danke dir für deine Geduld."}
